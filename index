<style>

:root{
  --ink:#0b0e13;
  --panel:#12161d;
  --panel-2:#161b24;
  --line:#242c38;
  --line-soft:#1b212b;
  --text:#e7eaf0;
  --text-mute:#8b93a3;
  --text-dim:#5b6474;
  --signal:#5eead4;
  --signal-dim:#2f5a54;
  --amber:#f2b84b;
  --amber-dim:#5c4a24;
  --radius:2px;
}

*{margin:0;padding:0;box-sizing:border-box;}

html{scroll-behavior:smooth;}

body{
  background:var(--ink);
  color:var(--text);
  font-family:'Inter',sans-serif;
  font-size:16px;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}

body::before{
  content:"";
  position:fixed;
  inset:0;
  background-image:
    linear-gradient(var(--line-soft) 1px, transparent 1px),
    linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
  background-size:64px 64px;
  opacity:0.35;
  pointer-events:none;
  z-index:0;
}

.mono{font-family:'JetBrains Mono',monospace;}

::selection{background:var(--signal-dim);color:var(--signal);}

a{color:inherit;text-decoration:none;}

@media (prefers-reduced-motion: reduce){
  *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; scroll-behavior:auto !important;}
}

/* ---------- LAYOUT SHELL ---------- */

.shell{
  position:relative;
  z-index:1;
  display:grid;
  grid-template-columns:220px 1fr;
  max-width:1280px;
  margin:0 auto;
}

.rail{
  position:sticky;
  top:0;
  align-self:start;
  height:100vh;
  padding:40px 0 40px 32px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  border-right:1px solid var(--line);
}

.rail-top .mark{
  font-family:'Space Grotesk',sans-serif;
  font-weight:600;
  font-size:15px;
  letter-spacing:0.02em;
  color:var(--text);
}
.rail-top .mark span{color:var(--signal);}

.rail-nav{
  margin-top:56px;
  display:flex;
  flex-direction:column;
  gap:4px;
}
.rail-nav a{
  font-size:13px;
  color:var(--text-dim);
  padding:8px 0;
  border-left:2px solid transparent;
  padding-left:14px;
  transition:color .15s ease, border-color .15s ease;
}
.rail-nav a:hover, .rail-nav a:focus-visible{
  color:var(--text);
  border-left-color:var(--signal-dim);
  outline:none;
}
.rail-nav a.active{
  color:var(--signal);
  border-left-color:var(--signal);
}

.rail-bottom{
  font-size:12px;
  color:var(--text-dim);
  line-height:1.8;
}
.rail-bottom a:hover{color:var(--signal);}

.main{padding:40px 48px 40px 56px;}

section{
  padding:96px 0;
  border-bottom:1px solid var(--line-soft);
  scroll-margin-top:32px;
}
section:last-of-type{border-bottom:none;}

.eyebrow{
  font-family:'JetBrains Mono',monospace;
  font-size:12px;
  color:var(--signal);
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:20px;
}
.eyebrow::before{
  content:"";
  width:6px;height:6px;
  background:var(--signal);
  border-radius:50%;
  box-shadow:0 0 8px var(--signal);
}

h2.h-title{
  font-family:'Space Grotesk',sans-serif;
  font-weight:600;
  font-size:30px;
  letter-spacing:-0.01em;
  margin-bottom:40px;
  max-width:600px;
}

/* ---------- HERO ---------- */

.hero{
  min-height:92vh;
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding-top:40px;
  border-bottom:1px solid var(--line-soft);
}

.hero-kicker{
  font-family:'JetBrains Mono',monospace;
  font-size:12.5px;
  color:var(--text-mute);
  margin-bottom:28px;
  display:flex;
  gap:10px;
  align-items:center;
}
.hero-kicker .dot{
  width:7px;height:7px;border-radius:50%;
  background:var(--amber);
  animation:pulse 2.4s ease-in-out infinite;
}
@keyframes pulse{
  0%,100%{opacity:1; box-shadow:0 0 0 0 rgba(242,184,75,0.5);}
  50%{opacity:0.55; box-shadow:0 0 0 6px rgba(242,184,75,0);}
}

h1.hero-name{
  font-family:'Space Grotesk',sans-serif;
  font-weight:700;
  font-size:clamp(44px, 6vw, 76px);
  line-height:1.02;
  letter-spacing:-0.02em;
  max-width:820px;
}

.hero-role{
  font-family:'Space Grotesk',sans-serif;
  font-weight:500;
  font-size:clamp(18px, 2vw, 22px);
  color:var(--text-mute);
  margin-top:20px;
  max-width:640px;
}

.hero-desc{
  margin-top:28px;
  max-width:540px;
  color:var(--text-mute);
  font-size:15.5px;
}

.hero-cta{
  display:flex;
  gap:14px;
  margin-top:40px;
  flex-wrap:wrap;
}
.btn{
  font-family:'JetBrains Mono',monospace;
  font-size:13px;
  padding:12px 20px;
  border:1px solid var(--line);
  color:var(--text);
  transition:border-color .15s ease, color .15s ease, background .15s ease;
}
.btn.primary{
  background:var(--signal);
  color:#08110f;
  border-color:var(--signal);
  font-weight:500;
}
.btn.primary:hover{background:#7ff0dd;}
.btn:not(.primary):hover{border-color:var(--signal-dim); color:var(--signal);}

/* telemetry strip */
.telemetry{
  margin-top:64px;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  border:1px solid var(--line);
}
.tcell{
  padding:18px 20px;
  border-right:1px solid var(--line);
}
.tcell:last-child{border-right:none;}
.tcell .tlabel{
  font-family:'JetBrains Mono',monospace;
  font-size:10.5px;
  color:var(--text-dim);
  letter-spacing:0.04em;
  margin-bottom:8px;
}
.tcell .tval{
  font-family:'Space Grotesk',sans-serif;
  font-size:22px;
  font-weight:600;
  color:var(--text);
}
.tcell .tval span{color:var(--signal); font-size:14px; font-weight:500;}

@media (max-width:720px){
  .telemetry{grid-template-columns:repeat(2,1fr);}
  .tcell:nth-child(2){border-right:none;}
}

/* ---------- SUMMARY ---------- */
.summary-grid{
  display:grid;
  grid-template-columns:1.3fr 1fr;
  gap:56px;
  align-items:start;
}
.summary-text p{
  font-size:16px;
  color:var(--text-mute);
  max-width:60ch;
}
.summary-text p + p{margin-top:16px;}

.panel{
  border:1px solid var(--line);
  background:var(--panel);
  padding:22px 24px;
  position:relative;
}
.panel::before{
  content:"";
  position:absolute;
  top:-1px;left:-1px;
  width:10px;height:10px;
  border-top:1px solid var(--signal);
  border-left:1px solid var(--signal);
}
.panel::after{
  content:"";
  position:absolute;
  bottom:-1px;right:-1px;
  width:10px;height:10px;
  border-bottom:1px solid var(--signal);
  border-right:1px solid var(--signal);
}
.panel-label{
  font-family:'JetBrains Mono',monospace;
  font-size:11px;
  color:var(--text-dim);
  letter-spacing:0.05em;
  margin-bottom:14px;
}
.focus-list{list-style:none;display:flex;flex-direction:column;gap:12px;}
.focus-list li{
  font-size:14px;
  color:var(--text-mute);
  padding-left:16px;
  position:relative;
}
.focus-list li::before{
  content:"";
  position:absolute;
  left:0; top:8px;
  width:6px;height:1px;
  background:var(--signal);
}
.focus-list li strong{color:var(--text); font-weight:500;}

/* ---------- SKILLS ---------- */
.skill-grid{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  gap:1px;
  background:var(--line);
  border:1px solid var(--line);
}
.skill-cell{
  background:var(--ink);
  padding:24px 26px;
}
.skill-cell .sc-head{
  display:flex;
  justify-content:space-between;
  align-items:baseline;
  margin-bottom:16px;
}
.skill-cell .sc-title{
  font-family:'Space Grotesk',sans-serif;
  font-weight:600;
  font-size:15px;
}
.skill-cell .sc-index{
  font-family:'JetBrains Mono',monospace;
  font-size:11px;
  color:var(--text-dim);
}
.chip-row{display:flex;flex-wrap:wrap;gap:8px;}
.chip{
  font-family:'JetBrains Mono',monospace;
  font-size:12px;
  color:var(--text-mute);
  border:1px solid var(--line);
  padding:5px 10px;
  transition:border-color .15s ease, color .15s ease;
}
.chip:hover{border-color:var(--signal-dim); color:var(--signal);}

@media (max-width:900px){
  .skill-grid{grid-template-columns:1fr;}
}

/* ---------- EXPERIENCE / TIMELINE ---------- */
.timeline{
  position:relative;
  padding-left:28px;
  border-left:1px solid var(--line);
}
.trow{
  position:relative;
  padding-bottom:44px;
}
.trow:last-child{padding-bottom:0;}
.trow::before{
  content:"";
  position:absolute;
  left:-33px; top:4px;
  width:9px;height:9px;
  background:var(--ink);
  border:1px solid var(--signal);
  border-radius:50%;
}
.trow .t-date{
  font-family:'JetBrains Mono',monospace;
  font-size:12px;
  color:var(--signal);
  margin-bottom:6px;
}
.trow .t-role{
  font-family:'Space Grotesk',sans-serif;
  font-size:19px;
  font-weight:600;
}
.trow .t-org{
  font-size:14px;
  color:var(--text-mute);
  margin-top:2px;
  margin-bottom:14px;
}
.trow ul{
  list-style:none;
  display:flex;
  flex-direction:column;
  gap:8px;
  max-width:640px;
}
.trow ul li{
  font-size:14.5px;
  color:var(--text-mute);
  padding-left:16px;
  position:relative;
}
.trow ul li::before{
  content:"—";
  position:absolute;
  left:0;
  color:var(--text-dim);
}

/* ---------- PROJECTS ---------- */
.proj{
  border:1px solid var(--line);
  margin-bottom:1px;
}
.proj-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:24px;
  padding:26px 28px;
  flex-wrap:wrap;
}
.proj-title{
  font-family:'Space Grotesk',sans-serif;
  font-size:20px;
  font-weight:600;
}
.proj-year{
  font-family:'JetBrains Mono',monospace;
  font-size:12px;
  color:var(--text-dim);
  white-space:nowrap;
  padding-top:4px;
}
.proj-stack{
  padding:0 28px 22px 28px;
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}
.stack-tag{
  font-family:'JetBrains Mono',monospace;
  font-size:11.5px;
  color:var(--text-dim);
  border:1px solid var(--line-soft);
  padding:4px 9px;
}
.proj-body{
  padding:0 28px 28px 28px;
  border-top:1px solid var(--line-soft);
  padding-top:20px;
}
.proj-body ul{
  list-style:none;
  display:flex;
  flex-direction:column;
  gap:10px;
  max-width:700px;
}
.proj-body ul li{
  font-size:14.5px;
  color:var(--text-mute);
  padding-left:16px;
  position:relative;
}
.proj-body ul li::before{
  content:"";
  position:absolute;
  left:0; top:8px;
  width:6px;height:1px;
  background:var(--amber);
}

/* ---------- EDUCATION / CERTS ---------- */
.two-col{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:56px;
}
@media (max-width:820px){
  .two-col{grid-template-columns:1fr;}
}
.edu-item{
  border-left:1px solid var(--line);
  padding-left:20px;
  margin-bottom:28px;
}
.edu-item:last-child{margin-bottom:0;}
.edu-item .e-date{
  font-family:'JetBrains Mono',monospace;
  font-size:11.5px;
  color:var(--text-dim);
  margin-bottom:6px;
}
.edu-item .e-deg{
  font-family:'Space Grotesk',sans-serif;
  font-size:16.5px;
  font-weight:600;
}
.edu-item .e-school{
  font-size:13.5px;
  color:var(--text-mute);
  margin-top:2px;
}

.cert-item{
  display:flex;
  gap:14px;
  padding:14px 0;
  border-bottom:1px solid var(--line-soft);
}
.cert-item:last-child{border-bottom:none;}
.cert-item .c-mark{
  font-family:'JetBrains Mono',monospace;
  font-size:11px;
  color:var(--signal);
  padding-top:3px;
}
.cert-item .c-name{
  font-size:14.5px;
  color:var(--text);
}
.cert-item .c-meta{
  font-size:12.5px;
  color:var(--text-dim);
  margin-top:3px;
}

/* ---------- FOOTER / CONTACT ---------- */
.contact{
  display:flex;
  flex-direction:column;
  gap:28px;
}
.contact-lead{
  font-family:'Space Grotesk',sans-serif;
  font-size:clamp(28px,4vw,42px);
  font-weight:600;
  letter-spacing:-0.01em;
  max-width:720px;
}
.contact-links{
  display:flex;
  gap:32px;
  flex-wrap:wrap;
  margin-top:8px;
}
.contact-links a{
  font-family:'JetBrains Mono',monospace;
  font-size:14px;
  color:var(--text-mute);
  border-bottom:1px solid var(--line);
  padding-bottom:4px;
  transition:color .15s ease, border-color .15s ease;
}
.contact-links a:hover{color:var(--signal); border-color:var(--signal);}

footer{
  padding:32px 0 12px 0;
  font-family:'JetBrains Mono',monospace;
  font-size:11.5px;
  color:var(--text-dim);
  display:flex;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:10px;
}

/* ---------- MOBILE ---------- */
@media (max-width:920px){
  .shell{grid-template-columns:1fr;}
  .rail{
    position:relative;
    height:auto;
    flex-direction:row;
    justify-content:space-between;
    align-items:center;
    padding:20px 24px;
    border-right:none;
    border-bottom:1px solid var(--line);
  }
  .rail-nav{
    margin-top:0;
    flex-direction:row;
    gap:16px;
    overflow-x:auto;
  }
  .rail-nav a{padding-left:0; border-left:none; border-bottom:2px solid transparent; padding-bottom:4px;}
  .rail-nav a.active{border-left:none; border-bottom-color:var(--signal);}
  .rail-bottom{display:none;}
  .main{padding:32px 24px;}
  .summary-grid{grid-template-columns:1fr;}
  section{padding:64px 0;}
}
</style>
